# Stag Fitness SaaS backend — environment template
# Fill JWT_SECRET and PII_KEY with `python -m scripts.gen_dev_secrets` (once per environment).

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stag_gym_saas
JWT_SECRET=
PII_KEY=

# Gym-local calendar day (attendance "today", expiry checks, revenue "today")
APP_TIMEZONE=Asia/Kolkata

# Frontend origin (CORS for the Vite dev server when not using its proxy)
FRONTEND_BASE_URL=http://localhost:5173
# Set true behind HTTPS so the refresh cookie gets the Secure flag
COOKIE_SECURE=false

# Seed (python -m app.utils.seed) — demo organization + logins
SEED_ORG_NAME=Stag Fitness
SEED_OWNER_EMAIL=owner@gym.com
SEED_OWNER_PASSWORD=owner123
SEED_TRAINER_EMAIL=trainer@gym.com
SEED_TRAINER_PASSWORD=trainer123
SEED_SUPERADMIN_EMAIL=superadmin@stag.local
SEED_SUPERADMIN_PASSWORD=Super@123
